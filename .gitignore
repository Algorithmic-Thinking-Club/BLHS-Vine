# Dependencies
node_modules/

# Build output
dist/
build/
.cache/
.vite/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
*.local
*.key
*.pem

# Sensitive / private data
/private/
/data/private/
*.pii.*
*-students.*
student-data/
exports/

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Working docs and notes (kept local)
docs/

# Markdown / written notes (text + AI-authored content stays out of git)
*.md

# PDFs are all construction/research docs (plans are sensitive); none are game output
*.pdf

# Superseded data snapshots
src/game/campus.geo.v2.json
src/game/campus.geo.v3.json
src/game/campus.geo.v4.json
src/game/campus.geo.v5.json

# Reference: keep MOST public (it shows the depth/complexity of the work).
# Only these buckets stay local:
#  - floorplans-maps: the school's blueprints + anything derived from them
#    (school security + architect copyright; one PDF is also >GitHub's 100MB limit)
#  - _archive: rough build screenshots + iteration junk (the unprofessional stuff)
#  - tools: bundled CLI binaries
reference/floorplans-maps/
reference/research/plan-pdfs/
reference/_archive/
reference/tools/
# real students' graduation photos — privacy, local reference only
reference/blhs-grad-capes/

# Build + map tooling: track the reusable pipeline only
scripts/*
!scripts/shot.ps1
!scripts/civil_extract.py
!scripts/build_campus_geo.py
!scripts/build_campus_dem.py
!scripts/build-campus-model.py
!scripts/build-pac.py
!scripts/palette_grade.py
!scripts/palette_grade_warm.py
!scripts/remove-bg.py
!scripts/bg-remove.py
!scripts/validate_feet.py
!scripts/render-campus.py
!scripts/pixelate-render.py
!scripts/normalize_tiles.py
!scripts/make_seamless_x.py
# the two files that prove the python runtime works. mp-spike.mjs was written,
# run and then swallowed by the scripts/* rule above, so the one thing the whole
# grape API rests on was never actually in the repo.
!scripts/mp-spike.mjs
!scripts/grape-proof.mjs

# Internal asset registries (kept local)
**/*-registry.md

# Bundled CLI tools (downloaded locally, not versioned)
reference/tools/
.browser-sessions/
!scripts/pl_gen.py
!scripts/port_align.py
!scripts/measure_sprites.py
reference/island-refs/
tsconfig.tsbuildinfo

# dev-only local database (the vite api bridge)
.data/

# Scratch: every throwaway probe, crop, render dump and screenshot pile lives
# under .tmp_ and never gets committed.
.tmp_*
__pycache__/
*.pyc

# Backup copies made before an edit (the pre-edit original of an art file),
# dated snapshots of a mask, and one-off diagnostic renders
*.orig.png
*.july.png
**/walker-diag.png

# Map/model tooling: same rule as scripts/ — track the reusable tools only.
# The Blender + map-machine side has its own repo; its scratch (addons, .blend,
# benchmark renders, downloaded packs) stays local.
tools/*
!tools/maskdraw/
!tools/objmap-walk.mjs
!tools/objmap-verify.mjs

# Reference (local-only buckets): frame libraries and teardowns of other games'
# art, plus interior photos. Study material, not ours to publish.
reference/octopath-bar/
reference/painted-scenes/
reference/codetavern-teardown/
reference/campus-interior/room-305/

# The demo scene wears a reference image as a technical stand-in — the runtime
# is ours, the picture is not, so it stays out.
public/art/scenes/town-square/

# Downloaded pages + extension indexes, saved while shopping for Blender addons
baga.html
blockout.html
ext.json
